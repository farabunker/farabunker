# Copy to .env and adjust for your machine. Never commit .env.
#
# SECRET_KEY and DEBUG ship here at their fresh-install values, but neither
# is what makes a fresh box reachable before an administrator exists --
# that is the OPEN posture, and an open box with DEBUG=0 is exactly as
# reachable and strictly safer. `identity.W003` names the shipped
# combination once per boot: an open box with DEBUG on answers every
# caller as an administrator, and any error renders this box's settings
# and environment to them. Turning it off (and leaving the open posture
# behind it) is a fixed-order runbook, not a one-line edit -- see
# docs/OPERATIONS.md section "Leaving the open posture".
SECRET_KEY=dev-insecure-change-me
DEBUG=1

# The hostnames this box will answer to. Unset, it defaults to loopback
# plus this machine's own hostname, which is what a LAN visitor uses.
# Add any other name that reaches the box (an mDNS `.local` alias, a
# CNAME, the name a reverse proxy presents). NEVER "*": a wildcard lets
# an attacker's DNS name resolve here and be served, which makes their
# page same-origin with this one. `identity.E003` refuses "*" whenever
# DEBUG is off.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],box.lan

# Only needed BEHIND TLS TERMINATION. Django checks a POST's Origin
# against http://<host> on a plain-HTTP box, which same-origin traffic
# already satisfies, so this stays empty for a direct LAN box. Behind a
# proxy that terminates HTTPS, name the browser-facing origins here,
# scheme included: https://box.example.com
# CSRF_TRUSTED_ORIGINS=

# Postgres + pgvector. Default matches `docker compose up -d db`.
#
# THE PASSWORD LIVES HERE, NOT IN compose.yaml (security audit S4). Both
# compose files interpolate ${POSTGRES_PASSWORD} into the db service AND
# into every app service's DATABASE_URL, so this one value is the whole
# credential and `docker compose up` refuses to start without it. Change
# it on a real box: `docs/OPERATIONS.md` §"Rotating the database
# password" is the exact sequence, and it is NOT just editing this line
# -- Postgres already holds the old one.
#
# CHOOSE YOUR OWN VALUE, then uncomment the line below. Shipped commented
# out on purpose -- so nobody carries this file's own example password
# onto a real box just by leaving it as-is -- and `docker compose up`
# refuses to start with a plain "set POSTGRES_PASSWORD in .env" error
# while it stays unset, rather than silently falling back to a shipped
# default.
# POSTGRES_PASSWORD=choose-your-own-password

# The URL the NATIVE (non-container) dev workflow uses. The containers
# compose their own from POSTGRES_PASSWORD above and ignore this line
# (compose `environment:` beats `env_file:`). If you set POSTGRES_PASSWORD
# above, change the password in this URL to match.
DATABASE_URL=postgres://farabunker:farabunker@localhost:5432/farabunker

# Inference Gateway target. On macOS dev, Ollama runs natively on the host
# (Docker can't reach the Metal GPU) — see ADR 0006. On the Linux appliance,
# this points at the Ollama container instead. Swap by config, not code.
OLLAMA_BASE_URL=http://localhost:11434

# There is NO default model, because there is no model to presume — a fresh
# box has nothing installed and nothing assigned. Register a model and assign
# it to a role in the model console (/inference); an unassigned role says so
# instead of pretending. The three variables below are OPTIONAL explicit
# overrides for an operator who deliberately wants to pin a role from the
# environment instead of the console. Leave them out entirely unless you mean
# them; setting a model here also requires its embedding dimension for the
# embeddings role.
# LLM_MODEL=
# EMBED_MODEL=
# EMBED_DIM=

# Managed document store root. Ingested files are copied under
# <FARABUNKER_DATA_DIR>/documents/<id>/ so the box owns its data instead of
# referencing arbitrary/temp source paths. Defaults to ./data next to the
# repo. In production this MUST point at a durable host-mounted volume, not
# container-local storage (see ADR 0006).
# FARABUNKER_DATA_DIR=./data

# Where `manage.py backup` writes by default. Defaults to
# <FARABUNKER_DATA_DIR>/backups -- the same durable, host-mounted volume as
# the document store, so a backup survives `docker compose down` (a location
# outside the checkout entirely would be container-local and ephemeral
# instead). The code writes the destination directory 0700 and every file
# in it 0600 either way; point this at a separate mounted, encrypted volume
# for real operational backups -- see docs/OPERATIONS.md "A database dump
# is now a credential store".
# FARABUNKER_BACKUP_DIR=./data/backups

# Image-generation engine (ComfyUI) location. Runs NATIVELY on the host so it
# can reach the GPU (Metal/CUDA/ROCm); the web container reaches it via
# host.docker.internal, same contract as Ollama. Start ComfyUI with
# `--listen 0.0.0.0` or it will only accept connections from the host itself.
# There is NO default checkpoint: place .safetensors files in
# ComfyUI/models/checkpoints/ and bind one to the Image generation role at
# /inference/.
COMFYUI_BASE_URL=http://localhost:8188

# Engine files (admin page at /vision/engine-files/): where the engine's OWN
# output/input folders really live on YOUR HOST, so compose.yaml can bind
# them into the web container read/write. There is NO default that points
# anywhere useful — every engine install lives somewhere different — so
# leaving these unset mounts a harmless empty local folder and the admin
# page will simply show nothing. Point them at ComfyUI's own `output`/
# `input` directories (or your engine's equivalent) to see and delete what
# it has actually written. (Deliberately NOT named ENGINE_OUTPUT_DIR/
# ENGINE_INPUT_DIR -- those are a separate, in-container setting compose.yaml
# itself pins; see its header comment.)
# COMFYUI_OUTPUT_DIR=/path/to/ComfyUI/output
# COMFYUI_INPUT_DIR=/path/to/ComfyUI/input

# Transcription engine (whisper.cpp's whisper-server) location. Runs
# NATIVELY on the host so it can reach the GPU; the web/watcher/worker
# containers reach it via host.docker.internal, same contract as Ollama and
# ComfyUI. Start it with `--host 0.0.0.0` or it will only accept connections
# from the host itself. There is NO default model file: whisper-server's own
# `-m <model-file>` start flag IS the model choice (one model per process --
# see models.contracts.engines.whisper.WhisperEngine.setup_guide). Port 8080
# is commonly used by other local dev servers too, so the health check
# sniffs the response body for a "whisper" marker before trusting it --
# don't be surprised if something else squatting on 8080 reads as
# unreachable rather than a false "Reachable".
WHISPER_BASE_URL=http://localhost:8080

# Feature toggles: a comma-separated list of enabled features. Default:
# "vision". Setting this variable REPLACES the default outright -- name every
# feature you want, e.g. FARABUNKER_FEATURES=vision,media -- and setting it to
# an empty value opts out of all of them.
#
# Valid flags:
#   vision  Image GENERATION: the vision.generate role and the /vision/ page.
#   media   Media INGESTION: video/audio transcription and vision text
#           extraction from images and scanned PDFs -- the rag.transcribe and
#           rag.extract roles, the media file extensions the watch folder and
#           the upload form accept, the scanned-PDF auto-detect, and the media
#           duration cap.
#
# "media" gates NEW intake only. Turning it off stops new media files from
# being accepted; it never strands media documents already ingested -- those
# still re-ingest, re-encode, and answer questions exactly as before.
# FARABUNKER_FEATURES=vision,media

# The box's own wall clock. Default: "UTC". Every date and time this box
# RENDERS is in this zone -- including the current date/time line and the
# per-message stamps a conversation's prompt carries when Settings ->
# Chat -> "Tell the model the date and time" is on, which is why it is
# worth setting on a box whose operator is not on UTC: left at the
# default, the model is told a time that is correct but not the one on
# your wall, and for part of every day not even the same DATE.
#
# Storage is unaffected -- datetimes are always stored in UTC. Any name
# the system's tz database knows works; an unknown one fails at startup
# rather than silently falling back.
# FARABUNKER_TIME_ZONE=America/Denver

# How long a queued generation job may sit before its card is marked stale
# (minutes, default 10).
# VISION_STALE_AFTER_MINUTES=10

# The one bound on how many bytes a single request may declare in its
# Content-Length header, refused with a 413 before anything reads the
# body. Default 4 GiB -- twice the per-file upload cap, so one large
# legitimate upload fits and a body carrying twenty of them does not.
# Lower it on a box with a small data volume; a lying Content-Length or
# a chunked body with none is not caught by this -- see docs/OPERATIONS.md
# §"The request-body cap" for what closes that (a reverse proxy this box
# does not have today).
# FARABUNKER_MAX_REQUEST_BYTES=4294967296
